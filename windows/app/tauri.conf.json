{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoMic",
  "version": "0.1.0",
  "identifier": "md.comic.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CoMic",
        "width": 1040,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0A0A0A"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
