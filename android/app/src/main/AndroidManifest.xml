<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microfonul si reteaua: fara ele aplicatia nu are ce sa faca. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Captura trebuie sa mearga si cu ecranul stins, deci serviciu in
         prim-plan. Din Android 14 tipul "microphone" cere permisiunea lui. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Din Android 13, notificarea serviciului se cere ca orice permisiune. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Telefoanele fara microfon nu exista, dar declaratia opreste instalarea
         pe ceasuri si televizoare care chiar nu au. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_comic"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoMic">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.CoMic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".stream.StreamService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
