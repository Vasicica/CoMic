<?xml version="1.0" encoding="utf-8"?>
<!--
  Un microfon desenat vectorial, ca sa nu avem de intretinut cinci marimi de PNG.
  Fundalul indigo e acelasi accent ca in fereastra de Windows (#818CF8).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#818CF8" />

    <!-- Capsula microfonului. -->
    <path
        android:pathData="M54,28a10,10 0 0 1 10,10v16a10,10 0 0 1 -20,0v-16a10,10 0 0 1 10,-10z"
        android:fillColor="#0A0A0A" />

    <!-- Arcul de sub capsula. -->
    <path
        android:pathData="M38,52v3a16,16 0 0 0 32,0v-3"
        android:strokeColor="#0A0A0A"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Piciorul si talpa. -->
    <path
        android:pathData="M54,71v9"
        android:strokeColor="#0A0A0A"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M43,80h22"
        android:strokeColor="#0A0A0A"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
</vector>
